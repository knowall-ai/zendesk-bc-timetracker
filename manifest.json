{
  "name": "Business Central Time Tracker",
  "author": {
    "name": "ocbentonita",
    "email": "ocbentonita@gmail.com"
  },
  "defaultLocale": "en",
  "private": false,
  "location": {
    "support": {
      "ticket_sidebar": {
        "url": "assets/iframe.html"
      }
    }
  },
  "version": "1.0.0",
  "frameworkVersion": "2.0",
  "parameters": [
    {
      "name": "bc_tenant_id",
      "type": "text",
      "required": true,
      "secure": false
    },
    {
      "name": "bc_environment",
      "type": "text",
      "required": true,
      "default": "production",
      "secure": false
    },
    {
      "name": "bc_company_id",
      "type": "text",
      "required": true,
      "secure": false
    },
    {
      "name": "bc_username",
      "type": "text",
      "required": true,
      "secure": false
    },
    {
      "name": "bc_password",
      "type": "text",
      "required": true,
      "secure": true
    }
  ]
}
